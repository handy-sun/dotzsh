pathl() {
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        printf '%s\n' "${path[@]}"
        return
    fi

    local rest="${PATH-}"
    local entry
    while [[ "$rest" == *:* ]]; do
        entry="${rest%%:*}"
        printf '%s\n' "$entry"
        rest="${rest#*:}"
    done
    printf '%s\n' "$rest"
}

hurs() {
    curl --proto '=https' --tlsv1.2 -LSv https://"$1"
}
