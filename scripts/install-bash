#!/usr/bin/env bash
## scripts/install-bash — set up dotzsh for Bash on non-NixOS machines.
##
## Runs the official Flyline installer, generates ~/.cache/dotzsh/common.sh
## via `common.sh.in -1`, and appends an idempotent source line to ~/.bashrc.
## Safe to re-run: existing Flyline and dotzsh entries are detected and kept.
##
## Usage:
##   scripts/install-bash
##
## Environment:
##   DOTZSH_INSTALL_BASH_FORCE=1  skip the NixOS guard (for testing)
set -euo pipefail

FLYLINE_INSTALL_URL="https://github.com/HalFrgrd/flyline/releases/latest/download/install.sh"
BASHRC="$HOME/.bashrc"

if [ -z "${BASH_VERSION:-}" ]; then
    echo "Error: this script must run under bash"
    exit 1
fi
: "${HOME:?Error: HOME is not set}"

# On NixOS the home-manager module (programs.dotzsh.enableBashIntegration)
# owns this wiring; a manual install would fight it.
if [ "${DOTZSH_INSTALL_BASH_FORCE:-0}" != "1" ] &&
   grep -Eq '^ID="?nixos"?$' /etc/os-release 2>/dev/null; then
    echo "Error: NixOS detected; use the dotzsh home-manager module instead"
    exit 1
fi

script_path=$(readlink -f "$0" 2>/dev/null || echo "$0")
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)

if [ ! -f "$repo_root/common.sh.in" ]; then
    echo "Error: common.sh.in not found under $repo_root"
    exit 1
fi
if [ ! -d "$repo_root/plugsfile" ]; then
    echo "Error: plugsfile/ not found under $repo_root (shared plugins would be missing)"
    exit 1
fi

# --- Flyline -----------------------------------------------------------------
# The official installer appends its `enable flyline ...` line to ~/.bashrc, but
# it skips that step — and still exits 0 — when FLYLINE_VERSION or FLYLINE_LOAD_DIR
# leak in from a shell that already has flyline loaded (it then assumes your
# setup is complete, and may even install next to the old copy instead), or when
# its own dlopen probe fails. So detect the line ourselves, give the installer a
# clean environment, and write the line ourselves if it still did not.
flyline_in_bashrc() {
    grep -qE '^[[:space:]]*enable[[:space:]]+(-f[[:space:]]+[^[:space:]]*libflyline[^[:space:]]*[[:space:]]+)?flyline([[:space:]]|$)' "$BASHRC" 2>/dev/null
}

find_flyline_lib() {
    local lib
    for lib in "$HOME/.local/lib/libflyline.so" "$HOME/.local/lib/libflyline.dylib"; do
        if [ -e "$lib" ]; then
            printf '%s\n' "$lib"
            return 0
        fi
    done
    return 1
}

# The library path an existing `enable -f ...` line points at (empty if the line
# uses the bare builtin form, in which case there is nothing to verify).
flyline_bashrc_lib() {
    sed -nE 's|.*enable[[:space:]]+-f[[:space:]]+"?([^"[:space:]]*libflyline[^"[:space:]]*)"?.*|\1|p' "$BASHRC" 2>/dev/null | head -n 1
}

flyline_lib=$(find_flyline_lib || true)
if flyline_in_bashrc; then
    echo ">>> Flyline already enabled in ~/.bashrc, skipping installation"
    enabled_lib=$(flyline_bashrc_lib)
    if [ -n "$enabled_lib" ] && [ ! -e "$enabled_lib" ]; then
        echo "Warning: ~/.bashrc loads flyline from $enabled_lib, which does not exist; delete that line and re-run to reinstall"
    fi
else
    echo ">>> Installing Flyline via official installer..."
    if command -v curl >/dev/null 2>&1; then
        fetch=(curl -sSfL)
    elif command -v wget >/dev/null 2>&1; then
        fetch=(wget -qO-)
    else
        echo "Error: neither curl nor wget is available to download Flyline"
        exit 1
    fi
    if ! "${fetch[@]}" "$FLYLINE_INSTALL_URL" | env -u FLYLINE_VERSION -u FLYLINE_LOAD_DIR bash; then
        echo "Error: Flyline installer failed"
        exit 1
    fi
    flyline_lib=$(find_flyline_lib || true)
    if ! flyline_in_bashrc; then
        # Never write a line for a library this bash cannot load. The probe has to
        # run interactively: flyline refuses to load in a non-interactive shell,
        # which would make every `enable -f` look like a failure.
        load_ok=false
        if [ -n "$flyline_lib" ] &&
           bash --norc --noprofile -i -c 'enable -f "$1" flyline' _ "$flyline_lib" >/dev/null 2>&1; then
            load_ok=true
        fi
        if [ -z "$flyline_lib" ]; then
            echo "Warning: the Flyline installer left no library under $HOME/.local/lib; the prompt falls back to the plain dotzsh PS1"
        elif [ "$load_ok" = false ]; then
            echo "Warning: $flyline_lib cannot be loaded by this bash; the prompt falls back to the plain dotzsh PS1"
        else
            printf '\n# Flyline - enhanced Bash experience\nenable flyline 2>/dev/null || enable -f "%s" flyline\n' "$flyline_lib" >>"$BASHRC"
            echo ">>> Added the Flyline enable line ourselves (the installer skipped it)"
        fi
    fi
fi

# --- common.sh ---------------------------------------------------------------
echo ">>> Generating ~/.cache/dotzsh/common.sh ..."
"$repo_root/common.sh.in" -1

# --- ~/.bashrc wiring --------------------------------------------------------
if grep -q 'dotzsh/common\.sh' "$BASHRC" 2>/dev/null; then
    echo ">>> ~/.bashrc already sources dotzsh common.sh, nothing to add"
else
    cat >>"$BASHRC" << 'EOF'

# --- github:handy-sun/dotzsh scripts/install-bash auto-sourced ---
[ -f "$HOME/.cache/dotzsh/common.sh" ] && source "$HOME/.cache/dotzsh/common.sh"
EOF
    echo ">>> Added dotzsh source line to ~/.bashrc"
fi

flyline_lib=""
for lib in "$HOME/.local/lib/libflyline.so" "$HOME/.local/lib/libflyline.dylib"; do
    [ -e "$lib" ] && flyline_lib=$lib && break
done

echo ""
echo ">>> Summary:"
echo "    Flyline lib:  ${flyline_lib:-not installed}"
echo "    Generated:    $HOME/.cache/dotzsh/common.sh"
echo "    Wired:        $BASHRC"
echo ""
echo "Note: keep this checkout at $repo_root — the generated file loads"
echo "      shared plugins (flyline prompt hook, etc.) from there."
echo ""
echo "Next: open a new Bash shell, then optionally run: flyline run-tutorial"
