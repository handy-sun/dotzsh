fi

_dotzsh_append_buffer << 'EOF'
## ----------------------- fish settings ---------------------- [[[1
## Set fish colors for better prompt
set -g fish_color_normal normal
set -g fish_color_command green
set -g fish_color_keyword magenta
set -g fish_color_quote yellow
set -g fish_color_redirection cyan
set -g fish_color_end yellow
set -g fish_color_error red
set -g fish_color_param normal
set -g fish_color_comment brblack
set -g fish_color_selection white --bold --background=brblack
set -g fish_color_search_match white --background=brblack
set -g fish_color_operator cyan
set -g fish_color_escape cyan
set -g fish_color_autosuggestion brblack

set -g fish_color_user brown
set -g fish_color_host yellow
set -g fish_color_cwd cyan

function reverse_history_search
    history | fzf --no-sort | read -l command
    if test $command
        commandline -rb $command
    end
end

function fish_user_key_bindings
    if type -q fzf_key_bindings
        fzf_key_bindings
    end

    bind \cr reverse_history_search
    bind -M insert \cr reverse_history_search
    # Ctrl+O to copy buffer
    bind \co copybuffer

    ## Vi Insert mode: Home key - beginning of line
    bind -M insert \e\[1~ beginning-of-line 2>/dev/null
    ## Vi Insert mode: Delete key
    bind -M insert \e\[3~ delete-char 2>/dev/null
    ## Vi Insert mode: End key - end of line
    bind -M insert \e\[4~ end-of-line 2>/dev/null

    bind \e\[H beginning-of-line
    bind \e\[1~ beginning-of-line
    ## End key - end of line
    bind \e\[F end-of-line
    bind \e\[4~ end-of-line
    ## Delete key
    bind \e\[3~ delete-char
    ## Right/Left arrow keys (word navigation)
    bind \eOc forward-word
    bind \eOd backward-word
    ## PageUp/PageDown - history search
    bind \e\[5~ history-search-backward
    bind \e\[6~ history-search-forward
    ## Ctrl+Backspace - delete previous word
    bind \cH backward-kill-word
    ## Shift+Backspace - undo
    bind \eH undo

    # fish_vi_key_bindings --no-erase insert
end

alias ... 'cd ../..'
alias .... 'cd ../../..'
alias ..... 'cd ../../../..'

## ----------------------- fish settings ---------------------- ]]]1
EOF

if [[ "$custom_prompt" == "1" ]]; then
    _dotzsh_append_buffer << 'EOF'
## custom fish prompt prefix to indicate proxy
if set -q HTTP_PROXY or set -q HTTPS_PROXY or set -q ALL_PROXY
    set -g __fish_prompt_prefix ">>"
else
    set -g __fish_prompt_prefix ">"
end

set -g __fish_git_prompt_showdirtystate 1
set -g __fish_git_prompt_showuntrackedfiles 1
set -g __fish_git_prompt_showstashstate 1
set -g __fish_git_prompt_show_informative_status 1
set -g __fish_git_prompt_char_stagedstate '+'
set -g __fish_git_prompt_char_dirtystate '*'
set -g __fish_git_prompt_char_untrackedfiles '?'
set -g __fish_git_prompt_char_stashstate '$'

if not set -q __fish_prompt_hostname
    if [ $COMPUTERNAME ]
        set -g __fish_prompt_hostname $COMPUTERNAME
    else if command -q hostname
        set -g __fish_prompt_hostname (hostname | cut -d . -f 1)
    else
        set -g __fish_prompt_hostname "unknown"
    end
end

function fish_prompt --description "Left prompt"
    set -l last_pipestatus $pipestatus
    set -lx __fish_last_status $status # Export for __fish_print_pipestatus.
    set -l normal (set_color normal)
    # Color the prompt differently when we're root
    set -l color_cwd $fish_color_cwd
    set -l suffix $__fish_prompt_prefix
    if functions -q fish_is_root_user; and fish_is_root_user
        if set -q fish_color_cwd_root
            set color_cwd $fish_color_cwd_root
        end
        set suffix '#'
    end

    # Write pipestatus
    # If the status was carried over (if no command is issued or if `set` leaves the status untouched), don't bold it.
    set -l bold_flag --bold
    set -q __fish_prompt_status_generation; or set -g __fish_prompt_status_generation $status_generation
    if test $__fish_prompt_status_generation = $status_generation
        set bold_flag
    end
    set __fish_prompt_status_generation $status_generation
    set -l status_color (set_color $fish_color_status)
    set -l statusb_color (set_color $bold_flag $fish_color_status)

    set -l prompt_status (__fish_print_pipestatus "[" "]" "|" "$status_color" "$statusb_color" $last_pipestatus)

    echo -n -s (set_color $color_cwd) (prompt_pwd) $normal (fish_vcs_prompt) $normal" "$prompt_status
    if test $__fish_last_status -eq 0
        echo -n -s (set_color brgreen)' '$suffix' '(set_color normal)
    else
        echo -n -s (set_color brred)' '$suffix' '(set_color normal)
    end
end

## Right prompt (fish_right_prompt)
function fish_right_prompt --description "Right prompt"
    set -l elapsed (math -s0 "$CMD_DURATION / 1000")
    set_color brblack
    if test $elapsed -ge 4
        if test $elapsed -ge 60
            set -l minutes (math -s0 $elapsed / 60)
            set -l seconds (math -s0 $elapsed % 60)
            if test $minutes -ge 60
                set -l hours (math -s0 $minutes / 60)
                set -l remain_mins (math -s0 $minutes % 60)
                echo -n $hours"h"$remain_mins"m"$seconds"s "
            else
                echo -n $minutes"m"$seconds"s "
            end
        else
            echo -n $elapsed"s "
        end
    end
    set_color normal

    ## ------ Background job count (cyan) ------
    set -l job_count (jobs -p | count)
    if test $job_count -gt 0
        echo -n -s (set_color cyan) "%$job_count "
    end
    ## ------ user@hostname and Current time (grey) ------
    echo -n -s (prompt_login) (set_color normal)
    echo -n -s (set_color white) ' ' (date +%H:%M:%S) (set_color normal)
    ## ------ SHLVL (when >= threshold) ------
    set -l _dotzsh_shlvl_threshold 1
    if test $SHLVL -gt $_dotzsh_shlvl_threshold
        echo -n -s (set_color -o bryellow) ' L' $SHLVL (set_color normal)
    end
end
EOF
else
    _dotzsh_append_buffer << 'EOF'
function _tide_item_proxy
    if set -q HTTP_PROXY; or set -q HTTPS_PROXY; or set -q ALL_PROXY
        printf ' 🌐 '
    end
end

function dotzsh_tide -d "Tide prompt helper"
    set -l cmd $argv[1]
    switch $cmd
        case ar
            if test (count $argv) -lt 2
                echo "Usage: dotzsh_tide ar <item> [item ...]"
                return 1
            end
            set -l items
            if set -q _tide_right_items[1]
                set items (string split '\x1e' $_tide_right_items)
            else if set -q tide_right_prompt_items[1]
                set items $tide_right_prompt_items
            end
            set -l new_items $items
            for item in $argv[2..-1]
                contains -- "$item" $new_items || set -a new_items $item
            end
            set --universal tide_right_prompt_items $new_items
            set --universal _tide_right_items $new_items
            echo "Appended right prompt items: $new_items"
        case set-vi-icon
            set --universal tide_character_vi_icon_default '→'
        case restore-vi-icon
            set --universal tide_character_vi_icon_default '❮'
        case rainbow
            set -l saved $tide_prompt_transient_enabled
            tide configure --auto --style=Rainbow --prompt_colors='True color' --show_time='24-hour format' --rainbow_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='One line' --prompt_spacing=Compact --icons='Many icons' --transient=No
            set --universal tide_prompt_transient_enabled $saved
        case lean
            set -l saved $tide_prompt_transient_enabled
            tide configure --auto --style=Lean --prompt_colors='True color' --show_time='24-hour format' --lean_prompt_height='One line' --prompt_spacing=Compact --icons='Many icons' --transient=No
            set --universal tide_prompt_transient_enabled $saved
        case lean2
            set -l saved $tide_prompt_transient_enabled
            tide configure --auto --style=Lean --prompt_colors='True color' --show_time='24-hour format' --lean_prompt_height='Two lines' --prompt_connection=Solid --prompt_connection_andor_frame_color=Darkest --prompt_spacing=Compact --icons='Many icons' --transient=No
            set --universal tide_prompt_transient_enabled $saved
        case transient-on
            set --universal tide_prompt_transient_enabled true
        case transient-off
            set --universal tide_prompt_transient_enabled false
        case remove-left
            set -l item $argv[2]
            if test -z "$item"
                echo "Usage: dotzsh_tide remove-left <item>"
                return 1
            end
            set -l items (string split '\x1e' $_tide_left_items)
            set -l new_items
            for i in $items
                test "$i" != "$item" && set -a new_items $i
            end
            set --universal tide_left_prompt_items $new_items
            set --universal _tide_left_items $new_items
            echo "Removed '$item' from left prompt items: $new_items"
        case remove-right
            set -l item $argv[2]
            if test -z "$item"
                echo "Usage: dotzsh_tide remove-right <item>"
                return 1
            end
            set -l items (string split '\x1e' $_tide_right_items)
            set -l new_items
            for i in $items
                test "$i" != "$item" && set -a new_items $i
            end
            set --universal tide_right_prompt_items $new_items
            set --universal _tide_right_items $new_items
            echo "Removed '$item' from right prompt items: $new_items"
        case reset-rainbow-left
            set --universal tide_left_prompt_items vi_mode os pwd git
            set --universal _tide_left_items $tide_left_prompt_items
            echo "Reset left prompt items to Rainbow default: vi_mode os pwd git"
        case reset-right
            set --universal tide_right_prompt_items status cmd_duration context jobs direnv bun node python rustc java php pulumi ruby go gcloud kubectl distrobox toolbox terraform aws nix_shell crystal elixir zig time shlvl
            set --universal _tide_right_items $tide_right_prompt_items
            echo "Reset right prompt items to default"
        case '*'
            echo "Usage: dotzsh_tide <subcommand>"
            echo "Subcommands:"
            echo "  ar <item> [item ...]  Append item(s) to right prompt items"
            echo "  remove-left <item>   Remove item from left prompt items"
            echo "  remove-right <item>  Remove item from right prompt items"
            echo "  reset-rainbow-left   Reset left prompt items to Rainbow default"
            echo "  reset-right          Reset right prompt items to default"
            echo "  set-vi-icon     Set vi icon to '→'"
            echo "  restore-vi-icon Restore vi icon to '❮'"
            echo "  rainbow         Configure Rainbow style"
            echo "  lean            Configure Lean style"
            echo "  lean2           Configure two-line Lean style"
            echo "  transient-on    Enable transient prompt"
            echo "  transient-off   Disable transient prompt"
    end
end

complete -c dotzsh_tide -f -a "ar remove-left remove-right reset-rainbow-left reset-right set-vi-icon restore-vi-icon rainbow lean lean2 transient-on transient-off"
EOF
fi

if [[ "$greeting" == "1" ]]; then
    _dotzsh_append_buffer << 'EOF'
## nix-shell fish greeting, show: current derivation, profile, and nix version
function fish_greeting
    set -l drv_info ""
    if test -n "$IN_NIX_SHELL"
        set drv_info "nix-shell ($name), SHLVL: $SHLVL"
    else if test -n "$DIRENV_DIR"
        set drv_info "direnv environment, SHLVL: $SHLVL"
    else
        ## Otherwise, read the host's NixOS derivation (strip the /nix/store/ hash prefix)
        set -l sys_path (readlink -f /run/current-system)
        set drv_info (string replace -r '^/nix/store/[a-z0-9]+-' "" $sys_path)
    end

    set -l profile_link (readlink /nix/var/nix/profiles/system)
    set -l cur_ver (string replace -r '.*-(\d+)-link$' '$1' $profile_link)

    set -l nix_ver (nix --version | string replace 'nix ' "")

    echo -s (set_color blue) "❄️ Derivation: " \
        (set_color cyan) "$drv_info" \
        (set_color normal) " | " \
        (set_color blue) "Generation: " \
        (set_color yellow) "$cur_ver" \
        (set_color normal) " | " \
        (set_color brblack) "$nix_ver" \
        (set_color normal)
end
EOF
fi

some_al="set localpost_arr \"$current_dir/localpost\" "

some_al+='"$HOME/.cache/dotzsh/localpost" "/tmp/localpost"
for localpost in $localpost_arr
    if test -d "$localpost"
        for i in "$localpost"/*.fish
            if test -r "$i"
                source "$i"
            end
        end
        break
    end
end
'

_dotzsh_append_buffer << EOF
$some_al
