rspid() {
    procs --no-header --only PID "$1" | xargs -n 1
}\n'
fi

some_al+=$'
tara() {
    tar cfa "${1}.tar.zst" "$2"
}
'

_dotzsh_append_buffer << EOF
$some_al
EOF

if _dotzsh_cmd_exists systemctl; then
    _dotzsh_append_buffer << 'EOF'
## systemctl
alias syta="systemctl status"
alias syca="systemctl cat --no-pager"
alias syst="sudo systemctl start"
alias syrs="sudo systemctl restart"
alias syte="sudo systemctl stop"
alias syrld="sudo systemctl reload"
alias syen="sudo systemctl enable"
alias syed="sudo systemctl edit"
alias syenw="sudo systemctl enable --now"
alias sydis="sudo systemctl disable"
alias sydisw="sudo systemctl disable --now"
alias sydr="sudo systemctl daemon-reload"
alias sylss="sudo systemctl list-units -t service"
alias sylsa="sudo systemctl list-units -t service --all"

alias suta="systemctl --user status"
alias suca="systemctl --user cat --no-pager"
alias sust="systemctl --user start"
alias surs="systemctl --user restart"
alias sute="systemctl --user stop"
alias surld="systemctl --user reload"
alias suen="systemctl --user enable"
alias sued="systemctl --user edit"
alias suenw="systemctl --user enable --now"
alias sudis="systemctl --user disable"
alias sudisw="systemctl --user disable --now"
alias sudr="systemctl --user daemon-reload"
alias sulss="systemctl --user list-units -t service"
alias sulsa="systemctl --user list-units -t service --all"

EOF
elif _dotzsh_cmd_exists launchctl; then
    _dotzsh_append_buffer << 'EOF'
# Search system/user services
syps() {
    if ! sudo launchctl list | grep -i "$1"; then
        launchctl list | grep -i "$1"
    fi
}
# View plist file
syca() {
    local plist_path=$(fd "$1" /Library/LaunchDaemons /Library/LaunchAgents ~/Library/LaunchAgents | head -n 1)
    if [ -n "$plist_path" ]; then
        echo $plist_path
        bat "$plist_path"
    fi
}
# launchctl load
syst() {
    local root_lib_path=$(fd "$1" /Library/LaunchDaemons /Library/LaunchAgents | head -n 1)
    if [ -n "$root_lib_path" ]; then
        echo "sudo launchctl load $root_lib_path"
        sudo launchctl load "$root_lib_path"
    else
        local user_lib_path=$(fd "$1" ~/Library/LaunchAgents | head -n 1)
        if [ -n "$user_lib_path" ]; then
            echo "launchctl load $user_lib_path"
            launchctl load "$user_lib_path"
        fi
    fi
}
# launchctl unload
syte() {
    local root_lib_path=$(fd "$1" /Library/LaunchDaemons /Library/LaunchAgents | head -n 1)
    if [ -n "$root_lib_path" ]; then
        echo "sudo launchctl unload $root_lib_path"
        sudo launchctl unload "$root_lib_path"
    else
        local user_lib_path=$(fd "$1" ~/Library/LaunchAgents | head -n 1)
        if [ -n "$user_lib_path" ]; then
            echo "launchctl unload $user_lib_path"
            launchctl unload "$user_lib_path"
        fi
    fi
}

EOF
fi

