some_al=''
if [ -n "$_dotzsh_is_linux" ]; then
    if du --apparent-size /dev/null &>/dev/null; then
        some_al+=$'
dus() {
    local _dir="${1:-.}"
    du --apparent-size -alh -d1 "$_dir" | sort -rh | head -n 21
}'
    else
        some_al+=$'
dus() {
    local _dir="${1:-.}"
    du -alh -d1 "$_dir" | sort -rh | head -n 21
}'
    fi

    some_al+=$'
qpid() {
    ps -eo pid,cmd | grep "$1" | grep -vE \'grep|\]$\' | awk \'{print$1;}\'
}\n'

else # darwin system
    some_al+=$'
dus() {
    du -Alh -d1 $1 | sort -rh | head -n 21
}

qpid() {
    ps -ef | grep "$1" | grep -vE \'grep|\]$\' | awk \'{print$2;}\'
}\n'
fi

if _dotzsh_cmd_exists procs; then
