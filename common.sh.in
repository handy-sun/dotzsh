alias glgd="git log --graph --decorate"
alias glp="glg --graph"
glh() {
    local output_lines=30
    local terminal_lines
    if ! terminal_lines="$(tput lines 2>/dev/null)"; then
        terminal_lines=
    fi

    if [[ "$terminal_lines" =~ ^[0-9]+$ ]]; then
        if ((terminal_lines <= 2)); then
            output_lines=0
        elif ((terminal_lines < 32)); then
            output_lines=$((terminal_lines - 2))
        fi
    fi

    glp --color=always | head -n "$output_lines"
}
