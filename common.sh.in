## about env:PS1(PROMPT), PS2, PS4
_PRE=$'\E['

PS2="${_PRE}0;33m>${_PRE}0m"
PS4="${_PRE}1;2m+${_PRE}0;33m$0:${_PRE}0;92m$LINENO${_PRE}m${_PRE}1;2m> ${_PRE}m"
unset _PRE

if [[ -n "$BASH_VERSION" ]]; then
    export HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/.bash_history"
    if [[ ! -d ${HISTFILE%/*} ]] && command -v mkdir &>/dev/null; then
        mkdir -p -- "${HISTFILE%/*}"
    fi
    if [[ ${PROMPT_COMMAND[*]:-} != *'_bash_prompt_cmd'* ]]; then
        if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a '* ]]; then
            PROMPT_COMMAND=(_bash_prompt_cmd "${PROMPT_COMMAND[@]}")
        else
            PROMPT_COMMAND="_bash_prompt_cmd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        fi
    fi
    HISTCONTROL=ignoreboth
    shopt -s histappend
    shopt -s autocd
    shopt -s checkwinsize
    shopt -s expand_aliases
    export HISTTIMEFORMAT='%F %T '
    if [[ $- == *i* ]]; then
        # Plain-readline fallback (Flyline rebinds Ctrl+w itself, see
        # flyline.plugin.sh): kill the previous alphanumeric word part so
        # punctuation like / - . _ acts as a boundary — matching zsh's
        # backward-kill-word with a trimmed WORDCHARS and fish's kill-word.
        bind '"\C-w": backward-kill-word'
        # Keep Readline from replacing this binding with the tty's whitespace rebout
        bind 'set bind-tty-special-chars off'
    fi

fi

_qip_query() {
    local source=$1 url=$2 response
    echo "=== $source ==="

    if ! response="$(curl -fsS --max-time 10 "$url")"; then
        echo "Error: $source query failed." >&2
        return 1
    fi

    if cmd_exists jq; then
        printf '%s\n' "$response" | jq '.' || {
            echo "Error: $source returned invalid JSON." >&2
            return 1
        }
    else
        printf '%s\n' "$response"
    fi
}

qip() {
    if [[ $# -ne 1 ]]; then
        echo "Usage: qip <IP-address>" >&2
        return 1
    fi

    local succeeded=0
    _qip_query ipwho.is "https://ipwho.is/$1" && succeeded=1
    _qip_query ip-api.com "http://ip-api.com/json/$1" && succeeded=1
    ((succeeded))
}

## ----------------------- conditional shell function ----------------------
EOF

if _dotzsh_cmd_exists jq; then
    _dotzsh_append_buffer << 'EOF'
ipacc() {
    curl -S ip-api.com/json 2>/dev/null | jq '.'
}

rlip4() {
    local route_ip vpn_name_pattern='^(zt|tailscale|wg|tun|tap|ppp)'
    local -a addr_args=(-j addr)
    if [[ $(uname) == Linux ]]; then
        addr_args=(-j -d addr)
    else
        vpn_name_pattern='^(zt|tailscale|wg|tun|tap|ppp|utun)'
    fi
    route_ip=$(ip -j route get 223.5.5.5 2>/dev/null | jq -r '.[0] | .prefsrc // .src // empty' 2>/dev/null)
    ip "${addr_args[@]}" | jq -r --arg route_ip "$route_ip" --arg vpn_name_pattern "$vpn_name_pattern" '
        [
            .[]
            | .ifname as $name
            | (.link_type // "") as $link_type
            | (.linkinfo.info_kind // "") as $kind
            | (
                ($link_type | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($kind | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($name | test($vpn_name_pattern; "i"))
              ) as $is_vpn
            | .addr_info[]?
            | select(.family == "inet" and (.local == $route_ip or $is_vpn or ($name | test("^wl"; "i"))))
            | { local, prefixlen, label: (.label // $name) }
        ]
        | unique_by(.local)
        | sort_by(if .local == $route_ip then 0 else 1 end)
        | .[]
        | "\(.local) \(.prefixlen) \(.label)"
    ' | column -t
}

rlip6() {
    local route_ip vpn_name_pattern='^(zt|tailscale|wg|tun|tap|ppp)'
    local -a addr_args=(-j -6 addr)
    if [[ $(uname) == Linux ]]; then
        addr_args=(-j -d -6 addr)
    else
        vpn_name_pattern='^(zt|tailscale|wg|tun|tap|ppp|utun)'
    fi
    route_ip=$(ip -j -6 route get 2400:3200::1 2>/dev/null | jq -r '.[0] | .prefsrc // .src // empty' 2>/dev/null)
    ip "${addr_args[@]}" | jq -r --arg route_ip "$route_ip" --arg vpn_name_pattern "$vpn_name_pattern" '
        [
            .[]
            | .ifname as $name
            | (.link_type // "") as $link_type
            | (.linkinfo.info_kind // "") as $kind
            | (
                ($link_type | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($kind | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($name | test($vpn_name_pattern; "i"))
              ) as $is_vpn
            | .addr_info[]?
            | select(
                .family == "inet6"
                and .scope == "global"
                and ((.deprecated // false) | not)
                and ((.tentative // false) | not)
                and (.local == $route_ip or $is_vpn)
              )
            | { local, prefixlen, label: (.label // $name) }
        ]
        | unique_by(.local)
        | sort_by(if .local == $route_ip then 0 else 1 end)
        | .[]
        | "\(.local) \(.prefixlen) \(.label)"
    ' | column -t
}

EOF
else
    _dotzsh_append_buffer << 'EOF'
ipacc() {
    curl -v ipinfo.io
}

EOF
    if [ -n "$_dotzsh_is_linux" ]; then
        _dotzsh_append_buffer << 'EOF'
rlip4() {
    local route_ip vpn_interfaces
    route_ip=$(ip -4 route get 223.5.5.5 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')
    vpn_interfaces=$(
        for kind in tun wireguard ppp; do
            ip -o link show type "$kind" 2>/dev/null
        done | awk -F': ' '{ sub(/@.*/, "", $2); print $2 }'
    )
    ip -o -4 addr list | awk -v route_ip="$route_ip" -v vpn_interfaces="$vpn_interfaces" '
        BEGIN {
            count = split(vpn_interfaces, interfaces, "\n")
            for (i = 1; i <= count; i++) is_vpn[interfaces[i]] = 1
        }
        {
            interface = $2
            sub(/@.*/, "", interface)
            split($4, cidr, "/")
            ip_address = cidr[1]
            if (ip_address == route_ip || is_vpn[interface] || tolower(interface) ~ /^(wl|zt|tailscale|wg|tun|tap|ppp)/) {
                if (!(ip_address in selected)) {
                    order[++selected_count] = ip_address
                    selected[ip_address] = ip_address " " cidr[2] " " interface
                }
            }
        }
        END {
            if (route_ip in selected) print selected[route_ip]
            for (i = 1; i <= selected_count; i++)
                if (order[i] != route_ip) print selected[order[i]]
        }
    ' | column -t
}

rlip6() {
    local route_ip vpn_interfaces
    route_ip=$(ip -6 route get 2400:3200::1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')
    vpn_interfaces=$(
        for kind in tun wireguard ppp; do
            ip -o link show type "$kind" 2>/dev/null
        done | awk -F': ' '{ sub(/@.*/, "", $2); print $2 }'
    )
    ip -o -6 addr show scope global | awk -v route_ip="$route_ip" -v vpn_interfaces="$vpn_interfaces" '
        BEGIN {
            count = split(vpn_interfaces, interfaces, "\n")
            for (i = 1; i <= count; i++) is_vpn[interfaces[i]] = 1
        }
        {
            interface = $2
            sub(/@.*/, "", interface)
            split($4, cidr, "/")
            ip_address = cidr[1]
            invalid = 0
            for (i = 1; i <= NF; i++)
                if ($i == "deprecated" || $i == "tentative") invalid = 1
            if (!invalid && (ip_address == route_ip || is_vpn[interface] || tolower(interface) ~ /^(zt|tailscale|wg|tun|tap|ppp)/)) {
                if (!(ip_address in selected)) {
                    order[++selected_count] = ip_address
                    selected[ip_address] = ip_address " " cidr[2] " " interface
                }
            }
        }
        END {
            if (route_ip in selected) print selected[route_ip]
            for (i = 1; i <= selected_count; i++)
                if (order[i] != route_ip) print selected[order[i]]
        }
    ' | column -t
}
EOF
    fi
fi

_dotzsh_append_buffer << 'EOF'
htdel() {
    if [[ -n "$HISTFILE" ]]; then
        local file=$HISTFILE
    elif [[ -n "$ZSH_VERSION" ]] && [ -e ~/.zhistory ]; then
        local file=~/.zhistory
    elif [[ -n "$BASH_VERSION" ]] && [ -e ~/.bash_history ]; then
        local file=~/.bash_history
    else
        return 1
    fi

    grep -rn $1 $file
EOF

if _dotzsh_cmd_exists perl; then
    _dotzsh_append_buffer << 'EOF'
    perl -i -ne "print unless m{$1}" $file
}
EOF
else
    if [ -n "$_dotzsh_is_linux" ]; then
        _dotzsh_append_buffer << 'EOF'
    if [[ "$1" =~ "/" ]]; then
        local transfer=`printf "$1" | sed 's#\/#\\\/#g'`
        ## use LC_ALL=C to avoid the file enconding diff with the terminal, which may cause the sed command not work well
        LC_ALL=C sed -i "/$transfer/d" $file
    else
        LC_ALL=C sed -i "/$1/d" $file
    fi
}
EOF
    else # darwin system
        _dotzsh_append_buffer << 'EOF'
    if [[ "$1" =~ "/" ]]; then
        local transfer=`printf "$1" | sed 's#\/#\\\/#g'`
        ## use LC_ALL=C to avoid the file enconding diff with the terminal, which may cause the sed command not work well
        LC_ALL=C sed -i "" "/$transfer/d" $file
    else
        LC_ALL=C sed -i "" "/$1/d" $file
    fi
}
EOF
    fi
fi

if [ -n "$_dotzsh_is_linux" ] && _dotzsh_cmd_exists ldd; then
    _dotzsh_append_buffer << 'EOF'
qlibc() {
    strings $1 | grep -E '^GLIBC_' | sort -Vu
}
EOF
fi

if _dotzsh_cmd_exists journalctl; then
    _dotzsh_append_buffer << 'EOF'
jnl() {
    journalctl -eu $1 | less +G
}
jfxeu() {
    journalctl -n 150 -f -xeu $1
}
juxeu() {
    journalctl --user -n 150 -f -xeu $1
}

_dotzsh_systemd_services() {
    systemctl list-unit-files --type=service --no-legend --no-pager 2>/dev/null | awk '{print $1}'
}
_dotzsh_systemd_user_services() {
    systemctl --user list-unit-files --type=service --no-legend --no-pager 2>/dev/null | awk '{print $1}'
}

if [ -n "$BASH_VERSION" ]; then
    _dotzsh_complete_jfxeu_bash() {
        local cur
        cur="${COMP_WORDS[COMP_CWORD]}"
        COMPREPLY=( $(compgen -W "$(_dotzsh_systemd_services)" -- "$cur") )
    }
    complete -F _dotzsh_complete_jfxeu_bash jfxeu
    _dotzsh_complete_juxeu_bash() {
        local cur
        cur="${COMP_WORDS[COMP_CWORD]}"
        COMPREPLY=( $(compgen -W "$(_dotzsh_systemd_user_services)" -- "$cur") )
    }
    complete -F _dotzsh_complete_juxeu_bash juxeu
elif [ -n "$ZSH_VERSION" ]; then
    _dotzsh_complete_jfxeu_zsh() {
        local -a services
        services=(${(f)"$(_dotzsh_systemd_services)"})
        compadd -a services
    }
    compdef _dotzsh_complete_jfxeu_zsh jfxeu
    _dotzsh_complete_juxeu_zsh() {
        local -a services
        services=(${(f)"$(_dotzsh_systemd_user_services)"})
        compadd -a services
    }
    compdef _dotzsh_complete_juxeu_zsh juxeu
fi

EOF
else # macOS
    _dotzsh_append_buffer << 'EOF'
jnl() {
    log show --predicate "process == \"$1\"" --info --last 1d
}

EOF
fi

