EOF

if _dotzsh_cmd_exists jq; then
    _dotzsh_append_buffer << 'EOF'
function ipacc -d "Query IP info"
    curl -S ip-api.com/json 2>/dev/null | jq '.'
end

function rlip4 -d "List routed, Wi-Fi, and VPN IPv4 addresses"
    set -l addr_args -j addr
    set -l vpn_name_pattern '^(zt|tailscale|wg|tun|tap|ppp)'
    if test (uname) = Linux
        set addr_args -j -d addr
    else
        set vpn_name_pattern '^(zt|tailscale|wg|tun|tap|ppp|utun)'
    end
    set -l route_ip (ip -j route get 223.5.5.5 2>/dev/null | jq -r '.[0] | .prefsrc // .src // empty' 2>/dev/null)
    ip $addr_args | jq -r --arg route_ip "$route_ip" --arg vpn_name_pattern "$vpn_name_pattern" '
        [
            .[]
            | .ifname as $name
            | (.link_type // "") as $link_type
            | (.linkinfo.info_kind // "") as $kind
            | (
                ($link_type | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($kind | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($name | test($vpn_name_pattern; "i"))
              ) as $is_vpn
            | .addr_info[]?
            | select(.family == "inet" and (.local == $route_ip or $is_vpn or ($name | test("^wl"; "i"))))
            | { local, prefixlen, label: (.label // $name) }
        ]
        | unique_by(.local)
        | sort_by(if .local == $route_ip then 0 else 1 end)
        | .[]
        | "\(.local) \(.prefixlen) \(.label)"
    ' | column -t
end

function rlip6 -d "List routed and VPN IPv6 addresses"
    set -l addr_args -j -6 addr
    set -l vpn_name_pattern '^(zt|tailscale|wg|tun|tap|ppp)'
    if test (uname) = Linux
        set addr_args -j -d -6 addr
    else
        set vpn_name_pattern '^(zt|tailscale|wg|tun|tap|ppp|utun)'
    end
    set -l route_ip (ip -j -6 route get 2400:3200::1 2>/dev/null | jq -r '.[0] | .prefsrc // .src // empty' 2>/dev/null)
    ip $addr_args | jq -r --arg route_ip "$route_ip" --arg vpn_name_pattern "$vpn_name_pattern" '
        [
            .[]
            | .ifname as $name
            | (.link_type // "") as $link_type
            | (.linkinfo.info_kind // "") as $kind
            | (
                ($link_type | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($kind | test("^(tun|tap|wireguard|ppp)$"; "i"))
                or ($name | test($vpn_name_pattern; "i"))
              ) as $is_vpn
            | .addr_info[]?
            | select(
                .family == "inet6"
                and .scope == "global"
                and ((.deprecated // false) | not)
                and ((.tentative // false) | not)
                and (.local == $route_ip or $is_vpn)
              )
            | { local, prefixlen, label: (.label // $name) }
        ]
        | unique_by(.local)
        | sort_by(if .local == $route_ip then 0 else 1 end)
        | .[]
        | "\(.local) \(.prefixlen) \(.label)"
    ' | column -t
end

EOF
else
    _dotzsh_append_buffer << 'EOF'
function ipacc -d "Query IP info"
    curl -v ipinfo.io
end

EOF
    if [ -n "$_dotzsh_is_linux" ]; then
        _dotzsh_append_buffer << 'EOF'
function rlip4 -d "List routed, Wi-Fi, and VPN IPv4 addresses"
    set -l route_ip (ip -4 route get 223.5.5.5 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')
    set -l vpn_interfaces (
        for kind in tun wireguard ppp
            ip -o link show type "$kind" 2>/dev/null
        end | awk -F': ' '{ sub(/@.*/, "", $2); print $2 }'
    )
    ip -o -4 addr list | awk -v route_ip="$route_ip" -v vpn_interfaces="$(string join \n $vpn_interfaces)" '
        BEGIN {
            count = split(vpn_interfaces, interfaces, "\n")
            for (i = 1; i <= count; i++) is_vpn[interfaces[i]] = 1
        }
        {
            interface = $2
            sub(/@.*/, "", interface)
            split($4, cidr, "/")
            ip_address = cidr[1]
            if (ip_address == route_ip || is_vpn[interface] || tolower(interface) ~ /^(wl|zt|tailscale|wg|tun|tap|ppp)/) {
                if (!(ip_address in selected)) {
                    order[++selected_count] = ip_address
                    selected[ip_address] = ip_address " " cidr[2] " " interface
                }
            }
        }
        END {
            if (route_ip in selected) print selected[route_ip]
            for (i = 1; i <= selected_count; i++)
                if (order[i] != route_ip) print selected[order[i]]
        }
    ' | column -t
end

function rlip6 -d "List routed and VPN IPv6 addresses"
    set -l route_ip (ip -6 route get 2400:3200::1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')
    set -l vpn_interfaces (
        for kind in tun wireguard ppp
            ip -o link show type "$kind" 2>/dev/null
        end | awk -F': ' '{ sub(/@.*/, "", $2); print $2 }'
    )
    ip -o -6 addr show scope global | awk -v route_ip="$route_ip" -v vpn_interfaces="$(string join \n $vpn_interfaces)" '
        BEGIN {
            count = split(vpn_interfaces, interfaces, "\n")
            for (i = 1; i <= count; i++) is_vpn[interfaces[i]] = 1
        }
        {
            interface = $2
            sub(/@.*/, "", interface)
            split($4, cidr, "/")
            ip_address = cidr[1]
            invalid = 0
            for (i = 1; i <= NF; i++)
                if ($i == "deprecated" || $i == "tentative") invalid = 1
            if (!invalid && (ip_address == route_ip || is_vpn[interface] || tolower(interface) ~ /^(zt|tailscale|wg|tun|tap|ppp)/)) {
                if (!(ip_address in selected)) {
                    order[++selected_count] = ip_address
                    selected[ip_address] = ip_address " " cidr[2] " " interface
                }
            }
        }
        END {
            if (route_ip in selected) print selected[route_ip]
            for (i = 1; i <= selected_count; i++)
                if (order[i] != route_ip) print selected[order[i]]
        }
    ' | column -t
end
EOF
    fi
fi

_dotzsh_append_buffer << 'EOF'
function htdel -d "Delete history entries matching pattern"
    set -l file
    if set -q fish_history
        set file ~/.local/share/fish/$fish_history.history
    else if test -e ~/.local/share/fish/fish_history
        set file ~/.local/share/fish/fish_history
    else if test -e ~/.bash_history
        set file ~/.bash_history
    else
        return 1
    end

    grep -n $argv[1] $file
EOF

if _dotzsh_cmd_exists perl; then
    _dotzsh_append_buffer << 'EOF'
    perl -i -ne "print unless m{$argv[1]}" $file
end
EOF
else
    if [ -n "$_dotzsh_is_linux" ]; then
        _dotzsh_append_buffer << 'EOF'
    if string match -q '*/*' $argv[1]
        set -l transfer (printf "$argv[1]" | sed 's#\/#\\\/#g')
        LC_ALL=C sed -i "/$transfer/d" $file
    else
        LC_ALL=C sed -i "/$argv[1]/d" $file
    end
end
EOF
    else # darwin system
        _dotzsh_append_buffer << 'EOF'
    if string match -q '*/*' $argv[1]
        set -l transfer (printf "$argv[1]" | sed 's#\/#\\\/#g')
        LC_ALL=C sed -i "" "/$transfer/d" $file
    else
        LC_ALL=C sed -i "" "/$argv[1]/d" $file
    end
end
EOF
    fi
fi

