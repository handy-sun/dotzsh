## eza/ls [[[
if _dotzsh_cmd_exists eza; then
    eza_al='alias ls="eza --group-directories-first -A"'

    if eza --git /dev/null &>/dev/null; then
        eza_al+=$'\nalias ll="ls -blg --git"'     # Long format, git status
    else
        eza_al+=$'\nalias ll="ls -blg"'
    fi
    eza_al+=$'\nalias l="ll -B"               # Long format, Byte size'
    eza_al+=$'\nalias la="ll -a"              # Long format, all files'
    eza_al+=$'\nalias lr="ll -T"              # Long format, recursive as a tree'
    eza_al+=$'\nalias lx="ll -sextension"     # Long format, sort by extension'
    eza_al+=$'\nalias lk="ll -ssize"          # Long format, largest file size last'
    eza_al+=$'\nalias lt="ll -smodified"      # Long format, newest modification time last'
    eza_al+=$'\nalias lc="ll -schanged"       # Long format, newest status change (ctime) last'

    _dotzsh_append_buffer << EOF
$eza_al

EOF
    _list_cmd='eza --group-directories-first -A -blg'
else
    if ls --color=auto /dev/null &>/dev/null; then
        _dotzsh_append_buffer << 'EOF'
[[ -z "$LS_OPTIONS" ]] && export LS_OPTIONS="--color=auto"
alias ls="command ls -A $LS_OPTIONS"
alias ll="ls -AlFh"
alias l="ls -AlF"
alias la="ls -alF"

EOF
    else
        _dotzsh_append_buffer << 'EOF'
alias ls="command ls -A"
alias ll="ls -AlFh"
alias l="ls -AlF"
alias la="ls -alF"

EOF
    _list_cmd='ls -AlFh $LS_OPTIONS'
    fi
fi
## eza/ls ]]]

## package management command [[[
_pkg_uid=0
_pkg_admin=''
if _dotzsh_cmd_exists pacman || _dotzsh_cmd_exists apt || _dotzsh_cmd_exists apk; then
    _pkg_uid=$(id -u)
    if [ "$_pkg_uid" -ne 0 ]; then
        if _dotzsh_cmd_exists sudo; then
            _pkg_admin='sudo '
        elif _dotzsh_cmd_exists doas; then
            _pkg_admin='doas '
        fi
    fi
fi

if _dotzsh_cmd_exists pacman; then
    _cmd=pacman
    _pkg_write_cmd="${_pkg_admin}${_cmd}"
    if [ "$_pkg_uid" -ne 0 ]; then
        if _dotzsh_cmd_exists yay; then
            _cmd=yay
            _pkg_write_cmd=yay
        elif _dotzsh_cmd_exists paru; then
            _cmd=paru
            _pkg_write_cmd=paru
        fi
    fi
    _dotzsh_append_buffer << EOF
alias pkgsy="$_pkg_write_cmd -S --noconfirm"
alias pkgr="$_pkg_write_cmd -R"
alias pkgssq="$_cmd -Ssq"
alias pkgss="$_cmd -Ss"
alias pkgsi="$_cmd -Si"
alias pkgqs="$_cmd -Qs"
alias pkgqi="$_cmd -Qi"
alias pkgqo="$_cmd -Qo"
## list files of local package without directory
pkgql() {
    $_cmd -Ql \$1 | grep -Ev '/\$' | awk '{print\$NF}' | xargs $_list_cmd
}
pkgssw() {
    $_cmd -Ss "^\${1}$"
}

EOF
elif _dotzsh_cmd_exists apt; then
    _cmd=apt
    _pkg_write_cmd="${_pkg_admin}${_cmd}"
    _dotzsh_append_buffer << EOF
alias pkgsy="$_pkg_write_cmd install -y"
alias pkgr="$_pkg_write_cmd remove"
alias pkgss="$_cmd search"
alias pkgsi="$_cmd show"
alias pkgqi="dpkg -s"
pkgqo() {
    which \$1 | xargs dpkg -S
}
## list files of local package without directory
pkgql() {
    dpkg -L \$1 | grep -Ev '\.\$' | xargs bash -c 'for ele do test ! -d \$ele && echo \$ele; done | xargs $_list_cmd' {}
}
pkgqs() {
    $_cmd list --installed 2>/dev/null | grep \$1
}
EOF
elif _dotzsh_cmd_exists apk; then
    _cmd=apk
    _pkg_write_cmd="${_pkg_admin}${_cmd}"
    ## TODO: May be need improve
    _dotzsh_append_buffer << EOF
alias pkgsy="$_pkg_write_cmd add"
alias pkgr="$_pkg_write_cmd del"
alias pkgss="$_cmd search"
EOF
elif _dotzsh_cmd_exists brew; then
    _cmd=brew
    _dotzsh_append_buffer << EOF
alias pkgsy="$_cmd install"
alias pkgr="$_cmd uninstall"
alias pkgss="$_cmd search"
alias pkgsi="$_cmd info"
alias pkgls="$_cmd list"
alias pkgdep="$_cmd deps"
EOF
fi
## package management command ]]]

## nix [[[
if _dotzsh_cmd_exists nix; then
    _dotzsh_append_buffer << 'EOF'
nxqa() {
    which "$1" | xargs realpath | xargs nix why-depends --all /run/current-system
}
EOF
    if [ -n "$_dotzsh_is_linux" ]; then
        if _dotzsh_cmd_exists nix-tree; then
            _dotzsh_append_buffer << 'EOF'
nxqt() {
    nix-store --gc --print-roots | rg -v '/proc/' | rg -Po '(?<= -> ).*' | xargs -o nix-tree
}
EOF
        fi
        _dotzsh_append_buffer << 'EOF'
nxqdh() {
    which "$1" | xargs realpath | xargs nix-store -q --deriver | \
        xargs nix why-depends --derivation ".#homeConfigurations.$USER.activationPackage" 2>/dev/null
}
EOF
    fi
fi
## nix ]]]

some_al=''
if _dotzsh_cmd_exists free; then
    some_al+=$'\nalias free="free -h"'
fi
if _dotzsh_cmd_exists trash; then
    some_al+=$'\nalias rm="trash"'
fi

if [ -n "$_dotzsh_is_linux" ] && _dotzsh_cmd_exists xclip; then
    some_al+=$'\nalias pbcopy="xclip -selection clipboard"\nalias pbpaste="xclip -selection clipboard -o"'
fi

if _dotzsh_cmd_exists rg; then
    some_al+=$'\nalias rga="rg -i --no-ignore"'
fi

if _dotzsh_cmd_exists fzf && _dotzsh_cmd_exists bat; then
    some_al+=$'\nalias fzf="fzf --preview '\''bat --color=always --style=header,grid --line-range :500 {}'\''"'
fi

if _dotzsh_cmd_exists tree; then
    some_al+=$'\nalias trelh="tree -AlFh"\nalias treds="tree -hF --du --sort=size | more"'
fi

if _dotzsh_cmd_exists dust; then
    some_al+=$'\nalias dur="dust -sr"\nalias durd="dust -srb -d 1"'
fi

if _dotzsh_cmd_exists aria2c; then
    some_al+=$'\nalias ar2c="aria2c -x 8 -s 6 -j 8"'
fi

if _dotzsh_cmd_exists fd; then
    if [ -n "$_dotzsh_is_linux" ]; then
        some_al+=$'\nalias fdf="fd -t f -H -I --exclude={.git,.svn,.vscode,.vs,.idea,node_modules,target,build,dist}"'
    else
        some_al+=$'\nalias fdf="fd -t f -H -I --exclude={.git,.svn,.vscode,.vs,.idea,node_modules,target,build,dist,OrbStack,Library,Pictures}"'
    fi

    some_al+=$'\nfdw() {
    fd -H -I "^${1}$" ${2}
}'
fi

if _dotzsh_cmd_exists unrar-free; then
    some_al+=$'\nalias unrar="unrar-free"'
fi

if _dotzsh_cmd_exists duf; then
    some_al+=$'\nalias dufhs="LC_ALL=en_US.UTF-8 duf --hide special"'
fi

if _dotzsh_cmd_exists nix; then
    some_al+=$'\nalias nxsc="nix config show"\nalias nxlg="sudo nix-env -p /nix/var/nix/profiles/system --list-generations"\nalias nxgc="sudo nix-collect-garbage --delete-older-than 4d"'
    if [ -n "$_dotzsh_is_linux" ]; then
        some_al+=$'\nalias nxcs="readlink /run/current-system"\nalias nxclsz="nix path-info /run/current-system --closure-size --human-readable"'
    fi
fi
if _dotzsh_cmd_exists nix-info; then
    some_al+=$'\nalias nxii="nix-info -m"'
fi

some_al+=$'\nalias clapp="claude --permission-mode bypassPermissions"'
some_al+=$'\nalias cbpp="codebuddy --permission-mode bypassPermissions"'
some_al+=$'\nalias cxpp="codex --yolo"'

_dotzsh_append_buffer << EOF
$some_al
EOF

_dotzsh_append_buffer << 'EOF'
_dotzsh_source_localpost() {
    local _dotzsh_localpost_dir="$1" _dotzsh_localpost_file
    if [[ -n ${ZSH_VERSION:-} ]]; then
        setopt localoptions null_glob
    fi
    for _dotzsh_localpost_file in "$_dotzsh_localpost_dir"/*.sh; do
        if [[ -r "$_dotzsh_localpost_file" ]]; then
            source "$_dotzsh_localpost_file"
        fi
    done
}

EOF

_dotzsh_append_buffer << EOF
_dotzsh_localpost_arr=("\${_dotzsh_localpost_base_dir:-${current_dir}/localpost}" "\$HOME/.cache/dotzsh/localpost" "/tmp/localpost")
for _dotzsh_localpost_dir in "\${_dotzsh_localpost_arr[@]}"; do
    if [[ -d "\$_dotzsh_localpost_dir" ]]; then
        _dotzsh_source_localpost "\$_dotzsh_localpost_dir"
        break
    fi
done
unset _dotzsh_localpost_arr _dotzsh_localpost_dir

EOF

_dotzsh_append_buffer << 'EOF'
if [[ -n ${BASH_VERSION:-} ]] && command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

if [[ -n ${BASH_VERSION:-} && $- == *i* ]]; then
    _dotzsh_title_installer='_dotzsh_title_trap_string="$(trap -p DEBUG)";trap - DEBUG;_dotzsh_bash_title_install'
    if [[ ${_dotzsh_title_hook_installed:-0} != 1 && ${PROMPT_COMMAND[*]:-} != *'_dotzsh_bash_title_install'* ]]; then
        if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a '* ]]; then
            PROMPT_COMMAND+=("$_dotzsh_title_installer")
        else
            PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}$_dotzsh_title_installer"
        fi
    fi
    if [[ ${PROMPT_COMMAND[*]:-} != *'_dotzsh_bash_preexec_arm'* ]]; then
        if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a '* ]]; then
            PROMPT_COMMAND+=(_dotzsh_bash_preexec_arm)
        else
            PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}_dotzsh_bash_preexec_arm"
        fi
    fi
    unset _dotzsh_title_installer
fi
EOF

if [[ "$generate_file" == "/dev/stdout" ]]; then
    echo -n "$SH_BUFFER"
else
    echo -n "$SH_BUFFER" > "$generate_file"
fi

unset OS_TYPE _dotzsh_is_linux real_location current_dir full_filename strip_in_name generate_file _cmd _list_cmd eza_al some_al SH_BUFFER

# vim: ft=bash:fdm=marker:fmr=[[[,]]]
